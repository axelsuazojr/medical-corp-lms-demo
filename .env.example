# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
DEMO_STUDENT_EMAIL=demo.student@medicalcorp.hn
DEMO_STUDENT_PASSWORD=change-this-demo-password
DEMO_TEACHER_EMAIL=demo.teacher@medicalcorp.hn
DEMO_TEACHER_PASSWORD=change-this-demo-password
DEMO_ADMIN_EMAIL=demo.admin@medicalcorp.hn
DEMO_ADMIN_PASSWORD=change-this-demo-password
INTERNAL_API_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token

# Payload / PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/medicalcorp
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Optional S3-compatible private storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth - wire in before production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Optional social
NEXT_PUBLIC_INSTAGRAM_URL=
